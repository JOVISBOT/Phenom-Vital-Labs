# Scratch files left at the repo root by ad-hoc debugging.
# Scoped to the root on purpose: an unanchored `verify-*.js` also swallowed
# tools/verify-data.js, so the data audit that gates `npm test` was silently
# untracked and would not have shipped.
/test-*.js
/test-*.html
/verify-*.js
/trace-*.js

# Scripts used for extraction
scripts/
!tools/
extract_*.js

# Original files (keep for reference but don't commit)
pdf-compact*.txt
pdf-compact.html
pdf-function.js
index-original.html
index-refactored.html

# Documentation that lives elsewhere
REVIEW*.md
PROJECT_BRIEF.md

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Environment variables - keep secrets local
.env

# Local verification artifacts
shots/
shots-live/
shots-ui/
ui-report.json

# scratch: openFDA responses and UI-driver output
.fda/
.out/
